# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Figma personal access token — https://www.figma.com/developers/api#access-tokens
FIGMA_TOKEN=

# Server
PORT=4000
NODE_ENV=development
AUTH_SESSION_SECRET=replace-with-a-long-random-secret
BLOCKSMITH_TOOL_SLUG=blocksmith

# SQLite database file (relative to packages/server unless absolute)
DATABASE_PATH=./.blocksmith/blocksmith.sqlite
SCRATCH_DIR=./.blocksmith/scratch
UPLOADS_DIR=./.blocksmith/uploads

# PostgreSQL Admin Console Database
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
ADMIN_USERS_TABLE=users
ADMIN_TOOLS_TABLE=tools
ADMIN_USER_TOOLS_TABLE=user_tools
ADMIN_AUDIT_LOGS_TABLE=audit_logs
ADMIN_PROJECTS_TABLE=projects
ADMIN_PROJECT_MEMBERS_TABLE=project_members
ADMIN_PROJECT_API_KEYS_TABLE=project_api_keys
# RDS requires TLS. Set DB_SSL_REJECT_UNAUTHORIZED=true when a trusted CA is configured.
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Web origin for CORS
WEB_ORIGIN=http://localhost:5173
